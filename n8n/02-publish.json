    {
      "parameters": {
        "operation": "executeQuery",
        "query": "with upd as (\n    update post_groups\n        set status = 'published',\n            ig_media_id = $2,\n            ig_permalink = $3,\n            error = null,\n            updated_at = now()\n        where id = $1\n        returning id, user_id),\n     logged as (\n         insert into publish_log (group_id, user_id, status, ig_media_id)\n             select id, user_id, 'success', $2\n             from upd\n             returning id)\nselect upd.id                  as group_id,\n       (select id from logged) as log_id\nfrom upd;",
        "options": {
          "queryReplacement": "={{ [ $('Данные для публикации').first().json.group_id, $('IG: публикация').first().json.id, $json.permalink || '' ] }}"
        }
