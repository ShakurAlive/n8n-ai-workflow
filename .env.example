# ==========================================================================
#  Скопируйте этот файл в .env и заполните значения:
#      macOS / Linux:       cp .env.example .env
#      Windows PowerShell:  Copy-Item .env.example .env
#  НИКОМУ не показывайте .env — там токены и пароли.
#
#  Отсюда читает переменные docker-compose.yml. Всё, что ниже раздела
#  «Instagram», нужно только на этапе настройки: рабочие значения хранятся
#  в таблице accounts, по строке на каждый аккаунт Instagram.
# ==========================================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=n8n

# База для таблиц бота: users, accounts, post_groups, prompt_templates.
# Отдельная от POSTGRES_DB, чтобы не смешивать данные бота со служебными
# таблицами самого n8n. Создаётся вручную, см. README, шаг «Создать таблицы».
SMMBOT_DB=smmbot

# ---------- Доступ к редактору n8n ----------
# Логин/пароль для входа в веб-интерфейс n8n (http://localhost:5678)
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_ME_admin_password
# Ключ шифрования учётных данных внутри n8n.
# Сгенерируйте: PowerShell ->  [guid]::NewGuid().ToString('N')
#               macOS/Linux ->  openssl rand -hex 16
# ВАЖНО: потеряете этот ключ — потеряете все креденшелы, сохранённые в n8n.
N8N_ENCRYPTION_KEY=CHANGE_ME_random_32_chars_string

# ---------- Сеть ----------
N8N_HOST=localhost
N8N_PROTOCOL=http
# Публичный HTTPS-URL из туннеля (cloudflared / ngrok), БЕЗ слэша в конце.
# Нужен, чтобы Telegram доставлял сообщения на webhook n8n.
# При быстром туннеле Cloudflare docker-compose подставляет адрес сам,
# это значение остаётся запасным вариантом.
WEBHOOK_URL=https://REPLACE_WITH_TUNNEL_URL

# Таймзона (для корректного времени в логах и расписаниях)
GENERIC_TIMEZONE=Asia/Bishkek

# ---------- Telegram ----------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AA...replace...
# Ваш числовой Telegram Id: @userinfobot.
# Нужен для строки в таблице users и для уведомлений об ошибках.
TELEGRAM_ADMIN_ID=

# ---------- Google Gemini ----------
# Ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=AQ...replace...

# Именно с префиксом models/ и с номером версии.
# Не берите gemini-flash-latest: под этим именем Google со временем подменяет
# модель, и однажды тон постов поедет сам собой.
GEMINI_MODEL=models/gemini-2.5-flash

# В креденшелах n8n поле Host должно содержать ТОЛЬКО базовый адрес,
# без /v1beta, без /models и без имени модели. Лишний хвост даёт ошибку 404 —
# это самая частая проблема с нодой Gemini.
GEMINI_HOST=https://generativelanguage.googleapis.com

# ---------- Хостинг медиа: Cloudinary ----------
# Instagram не принимает файлы напрямую, ему нужна публичная HTTPS-ссылка,
# которую он скачает сам. Cloudinary закрывает три задачи разом: хранит видео,
# отдаёт постоянные ссылки и обрезает кадр под сторис прямо в адресе файла.
# Регистрация: https://cloudinary.com/  (бесплатно, 25 кредитов в месяц)
#
# Cloud name виден на дашборде сразу после входа.
CLOUDINARY_CLOUD_NAME=
# Settings -> Upload -> Add upload preset -> Signing Mode: Unsigned.
# Unsigned нужен, чтобы не считать подпись запроса кодом внутри n8n.
CLOUDINARY_UPLOAD_PRESET=

# ---------- Instagram Graph API (Meta) ----------
# Рабочие значения лежат в таблице accounts, по строке на аккаунт.
# Здесь — только чтобы не потерять при настройке первого.
#
# ID Instagram-бизнес-аккаунта (числовой, см. docs/README-v1.md)
IG_USER_ID=1784xxxxxxxxxxx
# Долгоживущий Access Token, живёт около 60 дней — обновляйте заранее.
# Нужны права instagram_basic и instagram_content_publish.
IG_ACCESS_TOKEN=EAA...replace...
IG_API_VERSION=v21.0

# ---------- (опционально) Cloudflare Tunnel ----------
# Нужен только для РЕЖИМА 2 — именованного туннеля со стабильным адресом.
# По умолчанию поднимается быстрый туннель, ему токен не требуется.
# CLOUDFLARE_TUNNEL_TOKEN=eyJ...replace...
