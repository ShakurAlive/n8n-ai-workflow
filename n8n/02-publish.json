    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select m.public_url,\n       m.media_type,\n       g.ig_permalink,\n       g.chat_id,\n       g.id as group_id,\n       a.ig_username,\n       a.story_headline,\n       a.story_subline,\n       a.ig_user_id,\n       a.ig_access_token\nfrom post_media m\n         join post_groups g on g.id = m.group_id\n         join accounts a on a.id = g.account_id\nwhere m.group_id = $1\n  and m.public_url is not null\norder by m.id\nlimit 1;",
        "options": { "queryReplacement": "={{ [ $('Данные для публикации').first().json.group_id ] }}" }
      },
      "id": "p26-story-src",
      "name": "Обложка для сторис",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [3140, 120]
    },
    {
      "parameters": {
        "jsCode": "// Собираем картинку для сторис из уже загруженного в Cloudinary файла.\n// Трансформация делает кадр 1080x1920 и накладывает две подписи.\n// Кликабельную ссылку Instagram через API не принимает, поэтому\n// в подписи идёт отсылка к профилю, а сам permalink пишем мелким текстом.\nconst d = $input.first().json;\n\nconst headline = encodeURIComponent(d.story_headline || 'НОВЫЙ ПРОЕКТ');\nconst subline = encodeURIComponent(d.story_subline || 'подробности в профиле');\nconst handle = encodeURIComponent(d.ig_username ? '@' + d.ig_username : '');\n\nconst layers = [\n  'c_fill,w_1080,h_1920,g_auto',\n  'e_brightness:-15',\n  `l_text:Arial_78_bold:${headline},co_white,g_north,y_280`,\n  `l_text:Arial_46:${subline},co_white,g_south,y_360`,\n];\n\nif (handle) {\n  layers.push(`l_text:Arial_40_bold:${handle},co_white,g_south,y_270`);\n}\n\nconst overlay = layers.join('/');\nlet url = d.public_url;\n\nif (d.media_type === 'video') {\n  // so_1 берёт кадр на первой секунде и отдаёт его картинкой\n  url = url\n    .replace('/video/upload/', `/video/upload/so_1/${overlay}/`)\n    .replace(/\\.(mp4|mov|webm|m4v)$/i, '.jpg');\n} else {\n  url = url.replace('/upload/', `/upload/${overlay}/`);\n}\n\nreturn [{ json: { ...d, story_image_url: url } }];"
      },
      "id": "p27-story-img",
      "name": "Собрать сторис",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [3360, 120]
    },
